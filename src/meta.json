    "background_image_url": "assets/img/2026-global_trade_update_hero.jpg?v=3",
    "cta": {
      "label": "Read the update",
      "target_selector": ".current-issue"
    },
    "show_cta": false,
    "show_nav_cards": false,
    "nav_cards": [
      {
        "label": "Monthly policy insights",
