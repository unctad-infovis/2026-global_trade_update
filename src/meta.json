        "target_selector": ".policy-insights"
      },
      {
        "label": "Global trade snapshot",
        "image_url": "assets/img/2026-global_trade_update_nav_global_trade_snapshot.jpg?v=1",
        "target_selector": ".global-trade-snapshot"
      }
    ],
    "pills": [
      {
        "label": "Publications",
        "target_selector": ".publications_container"
      },
      {
        "label": "News",
        "target_selector": ".news_container"
      },
      {
        "label": "Videos",
        "target_selector": ".videos_container"
      }
    ]
  },
  "stats_strip": {
    "csv_url": "https://datawrapper.dwcdn.net/YmLLe/3/dataset.csv",
    "stats": [
      {
        "match": { "column": "Date", "value": "developed" },
        "value_column": "value",
        "label_column": "label",
        "label": "Digitally deliverable services share of exports, developed economies",
        "prefix": "",
        "suffix": "%",
        "decimals": 1
      },
      {
        "match": { "column": "Date", "value": "developing" },
        "value_column": "value",
        "label_column": "label",
        "label": "Digitally deliverable services share of exports, developing economies",
        "prefix": "",
        "suffix": "%",
        "decimals": 1
      },
      {
        "match": { "column": "Date", "value": "LDC" },
        "value_column": "value",
        "label_column": "label",
        "label": "Digitally deliverable services share of exports, least developed countries",
        "prefix": "",
        "suffix": "%",
        "decimals": 1
      }
    ]
  },
  "global_trade_snapshot": {
    "title": "Quarterly facts and figures",
    "description": "These graphs highlight key trends in global trade, drawing on the quarterly facts and figures edition of the global trade update.",
    "layout": "",
    "download": {
      "label": "facts and figures edition of the global trade update",
      "csv_url": "https://datawrapper.dwcdn.net/YmLLe/3/dataset.csv",
      "match": { "column": "Date", "value": "download_url" },
      "value_column": "url"
    },
    "tabs": [
      {
        "label": "Global trade growth",
        "chart_id": "otPNY"
      },
      {
        "label": "Goods vs. services trade",
        "chart_id": "AayJg"
      },
      {
        "label": "Regional trade growth",
        "chart_id": "xqCaY"
      }
    ]
  }
